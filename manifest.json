{
  "id": "tts",
  "name": "Speech Synthesis",
  "version": "0.3.3",
  "description": "On-device TTS (Supertonic) + cloud synthesis, with a Speech Synthesis settings tab and the cloud TTS endpoint card.",
  "abi": 3,
  "permissions": [
    "events",
    "secrets"
  ],
  "frontend": {
    "entry": "frontend.js"
  },
  "backend": {
    "library": "libtts_backend.dylib"
  },
  "versionCheckUrl": "https://github.com/companion-lab/companion-plugin-tts/releases/latest",
  "updateUrl": "https://github.com/companion-lab/companion-plugin-tts/releases/latest/download/tts-{version}-{platform}.zip"
}
